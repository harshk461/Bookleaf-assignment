# Paste into Railway → ai-service → Variables → RAW Editor
# Then replace GEMINI_API_KEY with your key from https://aistudio.google.com/apikey
# Remove any old OPENAI_API_KEY / OPENAI_MODEL variables from this service.

PORT=8000
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-flash-latest
MAX_DAILY_SPEND_USD=5.00
AI_SPEND_TRACKER_PATH=/tmp/ai_daily_spend.json

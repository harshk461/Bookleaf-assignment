# Copy values into each Railway service → Variables tab
# Reference syntax: ${{Postgres.DATABASE_URL}}, ${{backend.RAILWAY_PUBLIC_DOMAIN}}

# ─── Postgres (Railway plugin — auto-injected) ───────────────
# DATABASE_URL is created by the Postgres service

# ─── backend service (root directory = repo root /) ──────────
# REQUIRED — deploy will fail healthcheck without these:
PORT=4000
JWT_SECRET=replace-with-64-char-random-string
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_EXPIRES_IN=7d
DB_PROVIDER=pg
DB_POOL_SIZE=10
# Public Railway domain — HTTPS, no :8000 port (edge proxy uses 443)
AI_SERVICE_URL=https://ai-production-xxxx.up.railway.app
# Or keep private + public fallback:
# AI_SERVICE_URL=http://${{AI.RAILWAY_PRIVATE_DOMAIN}}:${{AI.PORT}}
# AI_SERVICE_PUBLIC_URL=https://${{AI.RAILWAY_PUBLIC_DOMAIN}}
REDIS_URL=${{Redis.REDIS_URL}}
# Set after frontend has a public domain:
CORS_ORIGIN=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# ─── ai-service (root directory = repo root /) ─────────────
# Paste deploy/railway.ai-service.env into Variables → RAW Editor (see README)
# Uses Google Gemini (not OpenAI) — free tier key at https://aistudio.google.com/apikey
PORT=8000
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-flash-latest
MAX_DAILY_SPEND_USD=5.00
AI_SPEND_TRACKER_PATH=/data/ai_spend.json

# ─── frontend service (root directory = repo root /) ───────
PORT=3000
NEXT_PUBLIC_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}

# Railway build variable for frontend Docker build:
# NEXT_PUBLIC_API_URL must be set before build (Railway → Variables → mark as build-time)

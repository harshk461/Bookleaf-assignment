{
  "name": "bookleaf-assignment",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:docker": "bash scripts/dev.sh docker",
    "setup": "bash scripts/setup.sh",
    "migrate": "bash scripts/migrate.sh",
    "seed": "bash scripts/seed.sh",
    "build": "npm run build --workspaces --if-present",
    "openapi:generate": "npm run openapi:generate -w apps/backend",
    "dev:frontend": "PORT=3000 npm run dev -w apps/frontend",
    "dev:backend": "PORT=4000 npm run dev -w apps/backend",
    "dev:ai": "cd apps/ai-service && PORT=8000 uvicorn app.main:app --reload --port 8000"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}

# ─── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://bookleaf:bookleaf@localhost:5432/bookleaf
DB_PROVIDER=pg
DB_POOL_SIZE=10

# ─── Backend (apps/backend) ───────────────────────────────────
# PORT is used by backend locally; docker-compose overrides PORT per service.
PORT=4000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# ─── Backend uploads ──────────────────────────────────────────
# Local dev: ./uploads  |  Docker/Railway: /data/uploads (mount a volume)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ─── AI Service (apps/ai-service) — Google Gemini ─────────────────
# Assignment originally suggested OpenAI; this project uses Gemini because
# the author could not add billing credits to OpenAI during development.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-flash-latest
MAX_DAILY_SPEND_USD=5.00
AI_SERVICE_PORT=8000

# ─── Frontend (apps/frontend) ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Seed ───────────────────────────────────────────────────
SEED_PASSWORD=Password123!
